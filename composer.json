{
  "name": "sathira/portfolio",
  "description": "Server-rendered portfolio and Markdown blog",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.6",
    "league/commonmark": "^2.6",
    "ezyang/htmlpurifier": "^4.18"
  },
  "require-dev": { "phpunit/phpunit": "^10.5" },
  "autoload": { "psr-4": { "App\\": "app/" }, "files": ["app/Helpers/functions.php"] },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "test": "phpunit",
    "migrate": "php bin/console migrate",
    "seed": "php bin/console seed",
    "schedule": "php bin/console schedule"
  },
  "config": { "sort-packages": true, "optimize-autoloader": true }
}
