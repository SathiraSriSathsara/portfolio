<?php
declare(strict_types=1);
$app=require dirname(__DIR__).'/bootstrap/app.php';
$db=(new App\Core\Database($app->config['db']))->connection();$command=$argv[1]??'help';
if($command==='migrate'){foreach(glob(BASE_PATH.'/database/migrations/*.sql')?:[] as $file){$name=basename($file);$db->exec('CREATE TABLE IF NOT EXISTS migrations (id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,migration VARCHAR(255) NOT NULL UNIQUE,ran_at DATETIME NOT NULL) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4');$s=$db->prepare('SELECT COUNT(*) FROM migrations WHERE migration=?');$s->execute([$name]);if($s->fetchColumn())continue;$db->exec((string)file_get_contents($file));$db->prepare('INSERT INTO migrations(migration,ran_at) VALUES(?,NOW())')->execute([$name]);echo "Migrated: $name\n";}exit;}
if($command==='seed'){$name=trim($_ENV['ADMIN_NAME']??'');$email=strtolower(trim($_ENV['ADMIN_EMAIL']??''));$password=$_ENV['ADMIN_PASSWORD']??'';if(!$name||!filter_var($email,FILTER_VALIDATE_EMAIL)||strlen($password)<12){fwrite(STDERR,"Set ADMIN_NAME, a valid ADMIN_EMAIL, and ADMIN_PASSWORD of at least 12 characters.\n");exit(1);}$algo=defined('PASSWORD_ARGON2ID')?PASSWORD_ARGON2ID:PASSWORD_DEFAULT;$s=$db->prepare("INSERT INTO users(name,email,password_hash,role,status,created_at,updated_at) VALUES(?,?,?,'admin','active',NOW(),NOW()) ON DUPLICATE KEY UPDATE name=VALUES(name),password_hash=VALUES(password_hash),updated_at=NOW()");$s->execute([$name,$email,password_hash($password,$algo)]);echo "Administrator seeded.\n";exit;}
if($command==='schedule'){$n=$db->exec("UPDATE posts SET status='published',published_at=COALESCE(published_at,NOW()),updated_at=NOW() WHERE status='scheduled' AND scheduled_at<=NOW() AND deleted_at IS NULL");$db->exec('DELETE FROM password_reset_tokens WHERE expires_at<NOW() OR used_at IS NOT NULL');echo "Published $n scheduled post(s).\n";exit;}
echo "Commands: migrate, seed, schedule\n";
