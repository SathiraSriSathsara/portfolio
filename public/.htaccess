Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|avif|ico)$"><Header set Cache-Control "public, max-age=31536000, immutable"></FilesMatch>
</IfModule>
